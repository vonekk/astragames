const AU = { ctx: null, ready: false };
function audio() {
  if (AU.ctx) { if (AU.ctx.state === 'suspended') AU.ctx.resume(); return; }
  const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
  const ctx = AU.ctx = new AC();
  const master = AU.master = ctx.createGain(); master.gain.value = .45; master.connect(ctx.destination);

  const eG = ctx.createGain(); eG.gain.value = 0;
  const eF = ctx.createBiquadFilter(); eF.type = 'lowpass'; eF.frequency.value = 600;
  const o1 = ctx.createOscillator(); o1.type = 'sawtooth'; o1.frequency.value = 60;
  const o2 = ctx.createOscillator(); o2.type = 'square'; o2.frequency.value = 91;
  o1.connect(eF); o2.connect(eF); eF.connect(eG); eG.connect(master);
  o1.start(); o2.start();
  AU.eng = { o1, o2, f: eF, g: eG };

  const sG = ctx.createGain(); sG.gain.value = 0;
  const sO = ctx.createOscillator(); sO.type = 'square'; sO.frequency.value = 720;
  const sf = ctx.createBiquadFilter(); sf.type = 'lowpass'; sf.frequency.value = 2000;
  const lfo = ctx.createOscillator(); lfo.frequency.value = .75;
  const lg = ctx.createGain(); lg.gain.value = 320;
  lfo.connect(lg); lg.connect(sO.frequency);
  sO.connect(sf); sf.connect(sG); sG.connect(master);
  sO.start(); lfo.start();
  AU.siren = sG;

  const len = Math.floor(ctx.sampleRate * .6);
  const buf = ctx.createBuffer(1, len, ctx.sampleRate);
  const d = buf.getChannelData(0);
  for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
  AU.noise = buf; AU.ready = true;
}
