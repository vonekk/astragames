
<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Dead Zone</title>
<style>
html,body{margin:0;height:100%;overflow:hidden;background:#080305;touch-action:none;
  font-family:system-ui,sans-serif;color:#fff;user-select:none}
canvas{display:block;width:100%;height:100%}
#ui{position:fixed;inset:0;pointer-events:none;padding:calc(12px + env(safe-area-inset-top)) 14px}
#row{display:flex;justify-content:space-between;font:700 12px/1.6 system-ui;letter-spacing:1px;color:#c09}
#row b{display:block;font-size:21px;color:#ff4d68}
#hpw{height:7px;background:rgba(255,255,255,.12);border-radius:4px;margin-top:8px;overflow:hidden}
#hp{height:100%;background:linear-gradient(90deg,#ff2d55,#ff9a3c);width:100%}
#msg{position:absolute;left:50%;top:40%;transform:translate(-50%,-50%);font:800 30px/1.3 system-ui;
  text-align:center;opacity:0;transition:.35s;color:#ff4d68}
#msg.on{opacity:1}
#fps{position:fixed;right:10px;bottom:10px;font:700 11px ui-monospace,monospace;color:#8dffb0;
  background:rgba(0,0,0,.55);padding:5px 8px;border-radius:6px;display:none}
</style></head><body>
<canvas id="c"></canvas>
<div id="ui">
  <div id="row">
    <div>ВОЛНА<b id="w">1</b></div>
    <div style="text-align:center">СЧЁТ<b id="s">0</b></div>
    <div style="text-align:right">ПАТРОНЫ<b id="a">∞</b></div>
  </div>
  <div id="hpw"><div id="hp"></div></div>
</div>
<div id="msg"></div><div id="fps">-- FPS</div>
<script>
const cvs=document.getElementById('c'),x=cvs.getContext('2d'),S=id=>document.getElementById(id);
const FPS_ON=new URLSearchParams(location.search).has('fps');
if(FPS_ON)S('fps').style.display='block';
let W,H,DPR;
function resize(){DPR=Math.min(devicePixelRatio||1,2);W=innerWidth;H=innerHeight;
  cvs.width=W*DPR;cvs.height=H*DPR;x.setTransform(DPR,0,0,DPR,0,0);}
addEventListener('resize',resize);resize();

const P={x:0,z:0,hp:100,ang:0,cool:0};
let wave=1,score=0,zombies=[],bullets=[],parts=[],spawnT=0,over=false;
const keys={},joy={x:0,y:0,id:null,ox:0,oy:0};

addEventListener('keydown',e=>{keys[e.code]=true;if(e.code.includes('Arrow'))e.preventDefault()});
addEventListener('keyup',e=>keys[e.code]=false);
/* мобильный стик — левая половина */
cvs.addEventListener('pointerdown',e=>{
  if(e.clientX<W*.5){joy.id=e.pointerId;joy.ox=e.clientX;joy.oy=e.clientY;}
  else aim(e.clientX,e.clientY);
});
cvs.addEventListener('pointermove',e=>{
  if(e.pointerId!==joy.id)return;
  let dx=(e.clientX-joy.ox)/60,dy=(e.clientY-joy.oy)/60;
  const l=Math.hypot(dx,dy);if(l>1){dx/=l;dy/=l;}
  joy.x=dx;joy.y=dy;
});
addEventListener('pointerup',e=>{if(e.pointerId===joy.id){joy.id=null;joy.x=joy.y=0;}});
cvs.addEventListener('contextmenu',e=>e.preventDefault());

function aim(sx,sy){
  P.ang=Math.atan2(sy-H/2,sx-W/2);
  if(P.cool<=0){shoot();P.cool=.12;}
}
function shoot(){
  bullets.push({x:P.x,y:P.z,vx:Math.cos(P.ang)*900,vy:Math.sin(P.ang)*900,life:.9});
}
function spawnZ(){
  const a=Math.random()*Math.PI*2,d=Math.max(W,H)*.75;
  zombies.push({x:P.x+Math.cos(a)*d,y:P.z+Math.sin(a)*d,hp:20+wave*8,sp:34+wave*4,ph:Math.random()*6});
}
function msg(t,ms=1400){S('msg').textContent=t;S('msg').classList.add('on');
  clearTimeout(msg._t);msg._t=setTimeout(()=>S('msg').classList.remove('on'),ms);}

let last=performance.now(),acc=0,frames=0;
function loop(now){
  requestAnimationFrame(loop);
  const dt=Math.min((now-last)/1000,.05);last=now;
  if(FPS_ON){frames++;acc+=dt;if(acc>.5){S('fps').textContent=Math.round(frames/acc)+' FPS';frames=0;acc=0;}}

  let mx=joy.x,my=joy.y;
  if(keys['KeyA']||keys['ArrowLeft'])mx-=1;
  if(keys['KeyD']||keys['ArrowRight'])mx+=1;
  if(keys['KeyW']||keys['ArrowUp'])my-=1;
  if(keys['KeyS']||keys['ArrowDown'])my+=1;
  const ml=Math.hypot(mx,my);if(ml>1){mx/=ml;my/=ml;}
  const spd=195;
  P.x+=mx*spd*dt;P.y=(P.z||0);
  P.z+=my*spd*dt;

  /* автонаведение на ближайшего, если не целишься мышью */
  let near=null,nd=1e9;
  for(const zb of zombies){const d=Math.hypot(zb.x-P.x,zb.y-P.z);if(d<nd){nd=d;near=zb;}}
  if(near&&nd<900)P.ang=Math.atan2(near.y-P.z,near.x-P.x);
  if(!('ontouchstart' in window))P.ang=Math.atan2(mouseY-H/2,mouseX-W/2);

  P.cool-=dt;
  if(P.cool<=0&&near){shoot();P.cool=.16;}

  /* пули */
  for(let i=bullets.length-1;i>=0;i--){
    const b=bullets[i];b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;
    for(const zb of zombies){
      if(Math.hypot(zb.x-b.x,zb.y-b.y)<18){zb.hp-=14;b.life=0;
        for(let k=0;k<4;k++)parts.push({x:b.x,y:b.y,vx:(Math.random()-.5)*260,vy:(Math.random()-.5)*260,life:.4});
        break;}
    }
    if(b.life<=0)bullets.splice(i,1);
  }
  /* зомби */
  spawnT-=dt;
  if(spawnT<=0&&!over){spawnT=Math.max(.25,1.1-wave*.07);spawnZ();}
  for(let i=zombies.length-1;i>=0;i--){
    const zb=zombies[i];
    const dx=P.x-zb.x,dy=P.z-zb.y,d=Math.hypot(dx,dy)||1;
    zb.x+=dx/d*zb.sp*dt;zb.y+=dy/d*zb.sp*dt;zb.ph+=dt*4;
    if(d<24){P.hp-=18*dt;}
    if(zb.hp<=0){zombies.splice(i,1);score+=10;continue;}
  }
  /* частицы */
  for(let i=parts.length-1;i>=0;i--){const p=parts[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt;if(p.life<=0)parts.splice(i,1);}

  if(P.hp<=0&&!over){over=true;msg('ТЫ МЁРТВ · СЧЁТ '+score,2600);
    setTimeout(()=>{P.hp=100;zombies=[];score=0;wave=1;over=false;},2800);}
  if(score>0&&score%200===0&&wave<99){wave++;score++;msg('ВОЛНА '+wave);}

  /* рисование */
  x.fillStyle='#080305';x.fillRect(0,0,W,H);
  const zoom=1;
  x.save();x.translate(W/2-P.x,H/2-P.z);
  /* сетка пола */
  x.strokeStyle='rgba(255,60,90,.08)';x.lineWidth=1;
  const g=64,ox=((P.x%g)+g)%g,oy=((P.z%g)+g)%g;
  for(let gx=-ox;gx<W+g;gx+=g){x.beginPath();x.moveTo(gx,-oy);x.lineTo(gx,H+g);x.stroke();}
  for(let gy=-oy;gy<H+g;gy+=g){x.beginPath();x.moveTo(-ox,gy);x.lineTo(W+g,gy);x.stroke();}

  for(const p of parts){x.globalAlpha=p.life*2;x.fillStyle='#ff3b52';x.fillRect(p.x,p.y,4,4);}
  x.globalAlpha=1;

  for(const zb of zombies){
    const s=1+Math.sin(zb.ph)*.08;
    x.fillStyle='#7a1020';x.beginPath();x.arc(zb.x,zb.y,13*s,0,7);x.fill();
    x.fillStyle='#ff2d55';x.beginPath();x.arc(zb.x-4,zb.y-3,2.6,0,7);x.arc(zb.x+4,zb.y-3,2.6,0,7);x.fill();
  }
  x.fillStyle='#ffe08a';
  for(const b of bullets){x.fillRect(b.x-2,b.y-2,4,4);}

  x.save();x.translate(P.x,P.z);x.rotate(P.ang);
  x.fillStyle='#e8e8f0';x.beginPath();x.arc(0,0,15,0,7);x.fill();
  x.fillStyle='#1a1020';x.fillRect(6,-4,22,8);
  x.restore();
  x.restore();

  S('hp').style.width=Math.max(0,P.hp)+'%';
  S('s').textContent=score;S('w').textContent=wave;
}
let mouseX=0,mouseY=0;
addEventListener('mousemove',e=>{mouseX=e.clientX;mouseY=e.clientY;});
requestAnimationFrame(loop);
</script></body></html>

<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Crimson Run</title>
<style>
html,body{margin:0;height:100%;overflow:hidden;background:#12030a;touch-action:none;
  font-family:system-ui,sans-serif;color:#fff;user-select:none}
canvas{display:block;width:100%;height:100%}
#ui{position:fixed;inset:0;pointer-events:none;padding:calc(14px + env(safe-area-inset-top)) 16px}
#row{display:flex;justify-content:space-between;font:700 12px/1.5 system-ui;letter-spacing:1px}
#row b{display:block;font-size:24px;color:#ff4d68}
#msg{position:absolute;left:50%;top:42%;transform:translate(-50%,-50%);font:800 28px/1.3 system-ui;
  text-align:center;opacity:0;transition:.3s}
#msg.on{opacity:1}
#fps{position:fixed;right:10px;bottom:10px;font:700 11px ui-monospace,monospace;color:#8dffb0;
  background:rgba(0,0,0,.55);padding:5px 8px;border-radius:6px;display:none}
</style></head><body>
<canvas id="c"></canvas>
<div id="ui"><div id="row">
  <div>СЧЁТ<b id="s">0</b></div>
  <div style="text-align:right">РЕКОРД<b id="b">0</b></div>
</div></div>
<div id="msg">ТАПНИ, ЧТОБЫ БЕЖАТЬ</div><div id="fps">-- FPS</div>
<script>
const cvs=document.getElementById('c'),x=cvs.getContext('2d'),S=id=>document.getElementById(id);
const FPS_ON=new URLSearchParams(location.search).has('fps');
if(FPS_ON)S('fps').style.display='block';
let W,H,DPR;
function resize(){DPR=Math.min(devicePixelRatio||1,2);W=innerWidth;H=innerHeight;
  cvs.width=W*DPR;cvs.height=H*DPR;x.setTransform(DPR,0,0,DPR,0,0);}
addEventListener('resize',resize);resize();

const G=1400;
const P={y:0,vy:0,onGround:true,slide:0};
let obs=[],coins=[],speed=420,dist=0,score=0,alive=true,started=false,best=+(localStorage.getItem('cr.best')||0);
const groundY=()=>H*0.78;

function jump(){
  if(!started){started=true;S('msg').classList.remove('on');return;}
  if(!alive)return reset();
  if(P.onGround){P.vy=-820;P.onGround=false;}
}
function slide(){
  if(P.onGround)P.slide=.45;
}
addEventListener('keydown',e=>{
  if(e.code==='Space'||e.code==='ArrowUp'||e.code==='KeyW'){e.preventDefault();jump();}
  if(e.code==='ArrowDown'||e.code==='KeyS'){e.preventDefault();slide();}
});
cvs.addEventListener('pointerdown',jump);
addEventListener('touchstart',e=>{if(e.touches.length>1)slide();},{passive:true});

function reset(){alive=true;obs=[];coins=[];speed=420;dist=0;score=0;P.y=0;P.vy=0;P.onGround=true;P.slide=0;
  S('msg').classList.remove('on');}
function msg(t){S('msg').textContent=t;S('msg').classList.add('on');}

let spawnT=0,last=performance.now(),acc=0,frames=0;
function loop(now){
  requestAnimationFrame(loop);
  const dt=Math.min((now-last)/1000,.05);last=now;
  if(FPS_ON){frames++;acc+=dt;if(acc>.5){S('fps').textContent=Math.round(frames/acc)+' FPS';frames=0;acc=0;}}

  if(started&&alive){
    dist+=speed*dt;speed=Math.min(1150,speed+16*dt);score=Math.floor(dist/10);
    P.vy+=G*dt;P.y+=P.vy*dt;
    if(P.y>=0){P.y=0;P.vy=0;P.onGround=true;}
    if(P.slide>0)P.slide-=dt;

    spawnT-=dt;
    if(spawnT<=0){
      spawnT=Math.max(.55,1.5-speed/1600);
      const tall=Math.random()<.45;
      obs.push({x:W+80,w:tall?46:76,h:tall?110:52,kind:tall?'tall':'low'});
      if(Math.random()<.6)coins.push({x:W+200+Math.random()*200,y:-90-Math.random()*90,got:false});
    }
    for(let i=obs.length-1;i>=0;i--){
      const o=obs[i];o.x-=speed*dt;
      const px=W*0.22,ph=P.slide>0?52:96,pw=54;
      const py=groundY()+P.y-(P.slide>0?52:96);
      if(o.x<px+pw&&o.x+o.w>px&&py+ph>groundY()-o.h&&py<groundY()){
        if(!(o.kind==='low'&&P.y<-20)){alive=false;msg('ПАДЕНИЕ · '+score);
          if(score>best){best=score;localStorage.setItem('cr.best',best);}}
      }
      if(o.x<-200)obs.splice(i,1);
    }
    for(let i=coins.length-1;i>=0;i--){
      const c=coins[i];c.x-=speed*dt;
      if(Math.abs(c.x-W*0.22)<40&&Math.abs(c.y-(P.y-60))<70){score+=50;coins.splice(i,1);continue;}
      if(c.x<-100)coins.splice(i,1);
    }
  }

  /* фон */
  const gd=x.createLinearGradient(0,0,0,H);
  gd.addColorStop(0,'#1a0209');gd.addColorStop(.5,'#3d0512');gd.addColorStop(1,'#0a0206');
  x.fillStyle=gd;x.fillRect(0,0,W,H);
  /* параллакс-город */
  for(let l=0;l<3;l++){
    x.fillStyle=['rgba(60,8,20,.85)','rgba(90,10,28,.7)','rgba(140,18,40,.45)'][l];
    const off=(dist*(0.06+l*0.09))%160;
    for(let i=-1;i<W/80+2;i++){
      const bx=i*80-off, bh=90+((i*37+l*53)%120);
      x.fillRect(bx,groundY()-bh,58,bh);
    }
  }
  /* земля */
  x.fillStyle='#160309';x.fillRect(0,groundY(),W,H);
  x.strokeStyle='#ff2d55';x.globalAlpha=.4;x.lineWidth=3;
  x.beginPath();x.moveTo(0,groundY());x.lineTo(W,groundY());x.stroke();x.globalAlpha=1;

  /* монеты */
  for(const c of coins){
    x.fillStyle='#ffd23f';x.beginPath();x.arc(c.x,groundY()+c.y,11,0,7);x.fill();
  }
  /* препятствия */
  for(const o of obs){
    x.fillStyle='#ff2d55';x.shadowColor='#ff2d55';x.shadowBlur=22;
    x.fillRect(o.x,groundY()-o.h,o.w,o.h);x.shadowBlur=0;
  }
  /* игрок */
  if(!alive){x.globalAlpha=.4;}
  const py=groundY()+P.y-(P.slide>0?52:96);
  x.fillStyle='#f4eaea';x.fillRect(W*0.22,py,38,P.slide>0?52:96);
  x.fillStyle='#ff2d55';x.fillRect(W*0.22,py,38,26);
  x.globalAlpha=1;

  S('s').textContent=score;S('b').textContent=best;
  if(!started)msg('ТАПНИ, ЧТОБЫ БЕЖАТЬ');
}
requestAnimationFrame(loop);
</script></body></html>

<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Blood 2048</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#0c0206;color:#fff;font-family:system-ui,sans-serif;
  touch-action:none;user-select:none;-webkit-user-select:none;overflow:hidden}
#wrap{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;
  padding:calc(16px + env(safe-area-inset-top)) 16px calc(16px + env(safe-area-inset-bottom))}
#head{width:100%;max-width:460px;display:flex;justify-content:space-between;align-items:center}
h1{margin:0;font-size:26px;letter-spacing:2px;color:#ff2d55}
#scores{text-align:right;font-size:11px;letter-spacing:1px;color:#a0888c}
#scores b{display:block;font-size:20px;color:#fff}
#board{position:relative;width:100%;max-width:460px;aspect-ratio:1;background:#1a0308;
  border:1px solid rgba(255,60,90,.25);border-radius:14px;padding:10px;
  display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(4,1fr);gap:8px}
.cell{border-radius:9px;display:grid;place-items:center;font-weight:800;
  font-size:clamp(16px,5vw,30px);transition:transform .1s;background:rgba(255,255,255,.04)}
.t2{background:#3a1018;color:#f0d0d4}.t4{background:#4a1220}
.t8{background:#6d0f22}.t16{background:#8b0a18}
.t32{background:#a30f1f}.t64{background:#bf1226}
.t128{background:#d81b32;font-size:clamp(14px,4.2vw,26px)}
.t256{background:#e83a45}.t512{background:#f25c50}
.t1024{background:#ff7a4d;color:#2a0508}.t2048{background:#ffd23f;color:#2a0508;
  box-shadow:0 0 30px rgba(255,210,63,.7)}
#bar{width:100%;max-width:460px;display:flex;gap:10px}
button{flex:1;padding:13px;border-radius:11px;border:1px solid rgba(255,60,90,.3);
  background:rgba(255,60,90,.12);color:#fff;font:700 12px/1 system-ui;letter-spacing:2px;cursor:pointer}
button:hover{background:rgba(255,60,90,.24)}
#over{position:fixed;inset:0;display:none;place-items:center;background:rgba(8,1,4,.85);backdrop-filter:blur(6px)}
#over.on{display:grid}
#over div{text-align:center;font-size:24px;font-weight:800;letter-spacing:2px}
#fps{position:fixed;right:10px;bottom:10px;font:700 11px ui-monospace,monospace;color:#8dffb0;
  background:rgba(0,0,0,.55);padding:5px 8px;border-radius:6px;display:none}
</style></head><body>
<div id="wrap">
  <div id="head">
    <h1>BLOOD 2048</h1>
    <div id="scores">СЧЁТ<b id="sc">0</b></div>
  </div>
  <div id="board"></div>
  <div id="bar"><button id="undo">ОТМЕНА</button><button id="new">ЗАНОВО</button></div>
</div>
<div id="over"><div>НЕТ ХОДОВ<br><span id="osc" style="font-size:15px;color:#a0888c"></span></div></div>
<div id="fps">-- FPS</div>
<script>
const S=id=>document.getElementById(id);
const FPS_ON=new URLSearchParams(location.search).has('fps');
if(FPS_ON)S('fps').style.display='block';

let g,score=0,prev=null,dead=false;
function empty(){return Array.from({length:4},()=>[0,0,0,0]);}
function addTile(){
  const free=[];g.forEach((r,i)=>r.forEach((v,j)=>{if(!v)free.push([i,j]);}));
  if(!free.length)return;
  const [i,j]=free[Math.floor(Math.random()*free.length)];
  g[i][j]=Math.random()<.9?2:4;
}
function render(){
  const b=S('board');b.innerHTML='';
  g.forEach(r=>r.forEach(v=>{
    const d=document.createElement('div');
    d.className='cell'+(v?' t'+v:'');
    d.textContent=v||'';
    b.appendChild(d);
  }));
  S('sc').textContent=score;
}
function clone(){return g.map(r=>r.slice());}

function move(dir){
  if(dead)return;
  const old=JSON.stringify(g);
  prev=clone();
  const n=4;
  const get=(i,j)=>g[i][j];
  for(let s=0;s<n;s++){
    const line=[];
    for(let k=0;k<n;k++){
      let i,j;
      if(dir==='left'){i=s;j=k;}
      else if(dir==='right'){i=s;j=n-1-k;}
      else if(dir==='up'){i=k;j=s;}
      else{i=n-1-k;j=s;}
      line.push(get(i,j));
    }
    const vals=line.filter(v=>v);
    const out=[];
    for(let k=0;k<vals.length;k++){
      if(vals[k]===vals[k+1]){out.push(vals[k]*2);score+=vals[k]*2;k++;}
      else out.push(vals[k]);
    }
    while(out.length<n)out.push(0);
    for(let k=0;k<n;k++){
      let i,j;
      if(dir==='left'){i=s;j=k;}
      else if(dir==='right'){i=s;j=n-1-k;}
      else if(dir==='up'){i=k;j=s;}
      else{i=n-1-k;j=s;}
      g[i][j]=out[k];
    }
  }
  if(JSON.stringify(g)!==old){addTile();render();check();}
}
function check(){
  if(g.flat().includes(2048)){/* победа, но играем дальше */}
  if(g.flat().some(v=>!v))return;
  for(let i=0;i<4;i++)for(let j=0;j<4;j++){
    if(j<3&&g[i][j]===g[i][j+1])return;
    if(i<3&&g[i][j]===g[i+1][j])return;
  }
  dead=true;S('osc').textContent='СЧЁТ '+score;S('over').classList.add('on');
}
function reset(){g=empty();score=0;dead=false;prev=null;addTile();addTile();render();S('over').classList.remove('on');}

addEventListener('keydown',e=>{
  const m={ArrowLeft:'left',ArrowRight:'right',ArrowUp:'up',ArrowDown:'down',
    KeyA:'left',KeyD:'right',KeyW:'up',KeyS:'down'}[e.code];
  if(m){e.preventDefault();move(m);}
});
/* свайпы */
let sx=0,sy=0,sw=false;
