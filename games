  const c = AU.ctx, t = c.currentTime;
  const s = c.createBufferSource(); s.buffer = AU.noise;
  const g = c.createGain(); g.gain.setValueAtTime(.45, t);
  g.gain.exponentialRampToValueAtTime(.001, t + .16);
  const f = c.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 1700;
  s.connect(f); f.connect(g); g.connect(AU.master);
  s.start(t); s.stop(t + .22);
  const o = c.createOscillator(); o.frequency.setValueAtTime(170, t);
  o.frequency.exponentialRampToValueAtTime(48, t + .16);
  const g2 = c.createGain(); g2.gain.setValueAtTime(.3, t);
  g2.gain.exponentialRampToValueAtTime(.001, t + .2);
  o.connect(g2); g2.connect(AU.master); o.start(t); o.stop(t + .22);
}
function tone(f, d, type = 'triangle', v = .05) {
  if (!AU.ready) return;
  const c = AU.ctx, t = c.currentTime;
  const o = c.createOscillator(); o.type = type; o.frequency.value = f;
  const g = c.createGain();
  g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(v, t + .02);
  g.gain.exponentialRampToValueAtTime(.0008, t + d);
  o.connect(g); g.connect(AU.master); o.start(t); o.stop(t + d + .05);
}
const NOTES = [196, 247, 294, 392, 294, 247, 220, 294, 349, 440, 349, 294];
let rStep = 0, rT = 0;

/* ---------- ввод ---------- */
const input = { x: 0, z: 0 };
const keys = {};
let firing = false, started = false;
const cam = { yaw: Math.PI, pitch: IS_TOUCH ? .42 : .3, dist: IS_TOUCH ? 9.5 : 8.5 };

addEventListener('keydown', e => {
  if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code)) e.preventDefault();
  keys[e.code] = true;
  if (e.code === 'KeyE') toggleCar();
  if (e.code === 'KeyM') startMission();
  if (e.code === 'Space' && !st.inCar) jump();
});
addEventListener('keyup', e => keys[e.code] = false);
renderer.domElement.addEventListener('click', () => {
  if (!IS_TOUCH && !document.pointerLockElement) renderer.domElement.requestPointerLock?.();
});
document.addEventListener('mousemove', e => {
  if (!document.pointerLockElement) return;
  cam.yaw -= e.movementX * .0026;
  cam.pitch = clamp(cam.pitch + e.movementY * .0022, -.3, 1.1);
});
document.addEventListener('mousedown', e => { if (e.button === 0 && document.pointerLockElement) firing = true; });
document.addEventListener('mouseup', () => firing = false);

let camId = null, cLastX = 0, cLastY = 0;
renderer.domElement.addEventListener('pointerdown', e => {
  if (!IS_TOUCH) return;
  camId = e.pointerId; cLastX = e.clientX; cLastY = e.clientY;
});
renderer.domElement.addEventListener('pointermove', e => {
  if (e.pointerId !== camId) return;
  cam.yaw -= (e.clientX - cLastX) * .005;
  cam.pitch = clamp(cam.pitch + (e.clientY - cLastY) * .004, -.3, 1.05);
  cLastX = e.clientX; cLastY = e.clientY;
});
addEventListener('pointerup', e => { if (e.pointerId === camId) camId = null; });

const stick = S('stick'), knob = S('knob');
let stickId = null;
function stickAt(e) {
  const r = stick.getBoundingClientRect();
  let dx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
  let dy = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
  const l = Math.hypot(dx, dy); if (l > 1) { dx /= l; dy /= l; }
  knob.style.transform = `translate(${dx * 36}px,${dy * 36}px)`;
  input.x = dx; input.z = -dy;
}
stick.addEventListener('pointerdown', e => {
  stickId = e.pointerId; stick.setPointerCapture(e.pointerId); stickAt(e); e.preventDefault();
});
stick.addEventListener('pointermove', e => { if (e.pointerId === stickId) { stickAt(e); e.preventDefault(); } });
const stickEnd = e => {
  if (e.pointerId !== stickId) return;
  stickId = null; input.x = 0; input.z = 0; knob.style.transform = 'translate(0,0)';
};
stick.addEventListener('pointerup', stickEnd);
stick.addEventListener('pointercancel', stickEnd);

function bind(id, down, up) {
  const el = S(id);
  el.addEventListener('pointerdown', e => {
    e.preventDefault(); el.classList.add('on'); audio(); down?.();
  });
  const rel = e => { e.preventDefault(); el.classList.remove('on'); up?.(); };
  el.addEventListener('pointerup', rel);
  el.addEventListener('pointercancel', rel);
  el.addEventListener('pointerleave', rel);
}
bind('bFire', () => firing = true, () => firing = false);
bind('bCar', () => toggleCar());
bind('bMiss', () => startMission());
bind('bJump', () => st.inCar ? keys['Space'] = !keys['Space'] : jump());

/* ---------- физика ---------- */
function jump() { if (!st.inCar && player.onGround) { player.vy = 9; player.onGround = false; } }

function collide(p, r) {
  for (const o of obstacles) {
    const dx = p.x - o.x, dz = p.z - o.z;
    const cx = clamp(dx, -o.hw, o.hw), cz = clamp(dz, -o.hd, o.hd);
    const ox = dx - cx, oz = dz - cz, d2 = ox * ox + oz * oz;
    if (d2 < r * r) {
      if (d2 > 1e-4) {
        const d = Math.sqrt(d2);
        p.x += ox / d * (r - d); p.z += oz / d * (r - d);
      } else {
        const px = o.hw - Math.abs(dx), pz = o.hd - Math.abs(dz);
        if (px < pz) p.x = o.x + (dx >= 0 ? 1 : -1) * (o.hw + r);
        else p.z = o.z + (dz >= 0 ? 1 : -1) * (o.hd + r);
      }
    }
  }
}
function bounds(p) {
  p.x = clamp(p.x, -LIMIT, BEACH + 120);
  p.z = clamp(p.z, -LIMIT, LIMIT);
}

function updatePlayer(dt) {
  const g = player.group;
  const run = keys['ShiftLeft'] || keys['ShiftRight'];
  const spd = run ? 9.4 : 5.4;
  let mx = input.x, mz = input.z;
  if (keys['KeyW'] || keys['ArrowUp']) mz += 1;
  if (keys['KeyS'] || keys['ArrowDown']) mz -= 1;
  if (keys['KeyA'] || keys['ArrowLeft']) mx -= 1;
  if (keys['KeyD'] || keys['ArrowRight']) mx += 1;
  const l = Math.hypot(mx, mz);
  if (l > 1) { mx /= l; mz /= l; }

  const fx = -Math.sin(cam.yaw), fz = -Math.cos(cam.yaw);
  const wx = fx * mz + (-fz) * mx, wz = fz * mz + fx * mx;

  if (wx || wz) {
    const ty = Math.atan2(wx, wz);
    let d = ((ty - player.yaw + Math.PI * 3) % TAU) - Math.PI;
    player.yaw += d * Math.min(1, dt * 14);
    player.pos.x += wx * spd * dt; player.pos.z += wz * spd * dt;
    player.phase += dt * (run ? 15 : 9);
  }
  player.vy -= 26 * dt; player.pos.y += player.vy * dt;
  if (player.pos.y <= 0) { player.pos.y = 0; player.vy = 0; player.onGround = true; }

  collide(player.pos, .75); bounds(player.pos);

  const sw = Math.sin(player.phase), amp = l > .05 ? 1 : .12;
  g.userData.legL.rotation.x = sw * .85 * amp;
  g.userData.legR.rotation.x = -sw * .85 * amp;
  g.userData.armL.rotation.x = -sw * .7 * amp;
  g.userData.armR.rotation.x = sw * .7 * amp;
  g.userData.armR.rotation.z = firing ? -.9 : 0;
  g.position.copy(player.pos); g.rotation.y = player.yaw;

  player.cd -= dt;
  if (firing && player.cd <= 0) { player.cd = .13; fire(); }
}

function fire() {
  const d = V3(); camera.getWorldDirection(d);
  d.y = clamp(d.y, -.45, .45); d.normalize();
  shoot(player.pos.clone().add(V3(0, 1.4, 0)).addScaledVector(d, .9), d, true);
  sfxShot();
  if (st.wanted === 0) setWanted(1); else st.cool = 13;
}

function nearest(max) {
  let best = null, bd = max;
  for (const c of cars) { const d = c.pos.distanceTo(player.pos); if (d < bd) { bd = d; best = c; } }
  return best;
}
function toggleCar() { st.inCar ? exitCar() : (nearest(6.5) && enterCar(nearest(6.5))); }
function enterCar(c) {
  st.inCar = c; c.ai = null; c.vel.set(0, 0, 0);
  player.group.visible = false; audio();
  if (c.isCop) setWanted(1);
  toast(c.isCop ? 'УГНАН КРУЗЕР' : 'МАШИНА УГНАНА');
  S('speedo').classList.add('show');
}
function exitCar() {
  const c = st.inCar; if (!c) return;
  st.inCar = null;
  player.pos.copy(c.pos).add(V3(-Math.cos(c.yaw), 0, Math.sin(c.yaw)).multiplyScalar(3.1));
  player.yaw = c.yaw; player.group.visible = true;
  collide(player.pos, .75);
  c.vel.set(0, 0, 0);
  S('speedo').classList.remove('show');
}

function driveCar(c, dt) {
  const sp = SPEC[c.kind];
  const gas = clamp(input.z + (keys['KeyW'] ? 1 : 0) - (keys['KeyS'] ? 1 : 0), -1, 1);
  const steer = clamp(input.x + (keys['KeyD'] ? 1 : 0) - (keys['KeyA'] ? 1 : 0), -1, 1);
  const hand = keys['Space'];

  const fwd = V3(Math.sin(c.yaw), 0, Math.cos(c.yaw));
  c.vel.addScaledVector(fwd, gas * sp.accel * dt);
  if (hand) c.vel.multiplyScalar(Math.max(0, 1 - 2.4 * dt));

  const speed = c.vel.length();
  c.vel.multiplyScalar(Math.max(0, 1 - (.55 + speed * .006) * dt * .85));
  if (speed > sp.max) c.vel.setLength(sp.max);

  /* КЛЮЧЕВОЙ ФИКС: D (steer = +1) поворачивает вправо → yaw уменьшается */
  const gripT = clamp(speed / 14, 0, 1);
  const back = c.vel.dot(fwd) >= 0 ? 1 : -1;
  c.yaw -= steer * sp.turn * dt * gripT * back;

  const f2 = V3(Math.sin(c.yaw), 0, Math.cos(c.yaw));
  const proj = c.vel.dot(f2);
  const want = f2.multiplyScalar(speed * (proj >= 0 ? 1 : -1));
  c.vel.lerp(want, clamp((hand ? sp.grip * .18 : sp.grip) * dt, 0, 1));

  c.pos.addScaledVector(c.vel, dt);
  collide(c.pos, sp.r); bounds(c.pos);
  c.mesh.position.copy(c.pos);
  c.mesh.rotation.y = c.yaw;
  c.mesh.rotation.z = lerp(c.mesh.rotation.z, -steer * gripT * .06, dt * 6);
  const spin = c.vel.length() * dt * 2.4;
  for (const w of c.mesh.userData.wheels) w.rotation.x += spin;

  S('speedo').innerHTML = '<b>' + Math.round(c.vel.length() * 3.6) + '</b> км/ч';

  if (c.vel.length() > 8) for (const p of peds) {
    if (p.alive && p.pos.distanceTo(c.pos) < 2.6) {
      p.alive = false; scene.remove(p.group); setWanted(1); sfxShot();
    }
  }
}

/* ---------- трафик и пешеходы ---------- */
function updateWorld(dt) {
  for (const c of cars) {
    if (c === st.inCar || !c.ai) continue;
    const a = c.ai;
    a.t += a.sp * dt;
    const p = perim(a.cx, a.cz, a.h, a.t);
    c.pos.set(p.x - p.dz * a.off, 0, p.z + p.dx * a.off);
    c.yaw = Math.atan2(p.dx, p.dz);
    c.mesh.position.copy(c.pos); c.mesh.rotation.y = c.yaw;
    const sp = a.sp * dt * 2.4;
    for (const w of c.mesh.userData.wheels) w.rotation.x += sp;
  }
  for (const p of peds) {
    if (!p.alive) continue;
    const flee = st.inCar && st.inCar.pos.distanceTo(p.pos) < 24;
    if (!flee) p.t += p.sp * dt;
    p.ph += dt * 3.4;
    const pp = perim(p.cx, p.cz, p.h, p.t);
    p.pos.set(pp.x, 0, pp.z);
    p.group.position.copy(p.pos);
    p.group.rotation.y = Math.atan2(pp.dx, pp.dz);
    const sw = Math.sin(p.ph);
    p.group.userData.legL.rotation.x = sw * .7;
    p.group.userData.legR.rotation.x = -sw * .7;
    p.group.userData.armL.rotation.x = -sw * .5;
    p.group.userData.armR.rotation.x = sw * .5;
  }
}

function updateCops(dt) {
  for (const c of cops) {
    const to = V3().subVectors(player.pos, c.pos), d = to.length();
    const want = Math.atan2(to.x, to.z);
    let df = ((want - c.yaw + Math.PI * 3) % TAU) - Math.PI;
    c.yaw += clamp(df, -2.4 * dt, 2.4 * dt);
    const spd = d > 16 ? 33 : d > 9 ? 18 : 2;
    c.vel.lerp(V3(Math.sin(c.yaw), 0, Math.cos(c.yaw)).multiplyScalar(spd), clamp(2.6 * dt, 0, 1));
    c.pos.addScaledVector(c.vel, dt); c.pos.y = 0;
    collide(c.pos, 1.9); bounds(c.pos);
    c.mesh.position.copy(c.pos); c.mesh.rotation.y = c.yaw;

    const L = c.mesh.userData.lights;
    if (L) {
      L.t += dt; const on = Math.floor(L.t * 6) % 2 === 0;
      L.l.material.emissiveIntensity = on ? 6 : .4;
      L.r.material.emissiveIntensity = on ? .4 : 6;
    }
    if (d < 30) {
      c.cd -= dt;
      if (c.cd <= 0) {
        c.cd = rnd(1.1, 2.4);
        shoot(c.pos.clone().add(V3(0, 1.6, 0)), to.normalize(), false);
        sfxShot();
        if (Math.random() < .4) hurt(rndI(4, 8));
      }
    }
    if (d < 6 && c.vel.length() > 10) hurt(2);
  }
}

function hurt(n) {
  st.hp -= n; hud();
  if (st.hp <= 0) {
    if (st.inCar) exitCar();
    st.hp = 100; st.money = Math.max(0, st.money - 300);
    player.pos.set(0, 0, 26); setWanted(0);
    for (const c of cops) scene.remove(c.mesh); cops.length = 0;
    toast('ТЫ ОТКЛЮЧИЛСЯ · -$300');
  }
}

function updateBullets(dt) {
  for (let i = bullets.length - 1; i >= 0; i--) {
    const b = bullets[i];
    b.life -= dt;
    b.pos.addScaledVector(b.dir, 190 * dt);
    b.mesh.position.copy(b.pos);
    b.mesh.material.opacity = clamp(b.life * 2, 0, 1);
    if (b.mine) {
      for (const c of cops) {
        if (b.pos.distanceTo(_v1.copy(c.pos).setY(1)) < 2.6) {
          c.hp -= 34; b.life = 0;
          if (c.hp <= 0) {
            scene.remove(c.mesh);
            cops.splice(cops.indexOf(c), 1);
            st.money += 400; hud();
          }
          break;
        }
      }
      for (const p of peds) {
        if (p.alive && b.pos.distanceTo(_v1.copy(p.pos).setY(1)) < 1.8) {
          p.alive = false; scene.remove(p.group); setWanted(1); b.life = 0; break;
        }
      }
    } else if (b.pos.distanceTo(_v1.copy(player.pos).setY(1)) < 1.4) {
      hurt(rndI(5, 9)); b.life = 0;
    }
    if (b.life <= 0) { scene.remove(b.mesh); bullets.splice(i, 1); }
  }
}

function updateMission(dt) {
  if (!mission.on) return;
  mission.t -= dt;
  const t = Math.max(0, mission.t);
  S('mTime').textContent = Math.floor(t / 60) + ':' + String(Math.floor(t % 60)).padStart(2, '0');
  S('mTime').classList.toggle('warn', t < 15);
  const p = st.inCar ? st.inCar.pos : player.pos;
  if (p.distanceTo(mission.pts[mission.idx]) < 5.5) {
    mission.idx++;
    const m = mission.mk.pop(); if (m) scene.remove(m);
    if (mission.idx >= mission.pts.length) { endMission(true); return; }
    marker(mission.pts[mission.idx]);
    tone(880, .16); setTimeout(() => tone(1320, .22), 100);
    toast('ЧЕКПОИНТ ' + mission.idx + '/5');
  }
  if (mission.t <= 0) endMission(false);
}

/* ---------- HUD ---------- */
const radar = S('radar'), rx = radar.getContext('2d');
function drawRadar() {
  const W = radar.width, R = W / 2, sc = 1.15;
  rx.clearRect(0, 0, W, W);
  rx.save();
  rx.beginPath(); rx.arc(R, R, R - 3, 0, TAU); rx.clip();
  rx.fillStyle = '#0b0a12'; rx.fillRect(0, 0, W, W);
  const f = st.inCar ? st.inCar.pos : player.pos;
  const ox = R - f.x * sc, oz = R - f.z * sc;
  rx.fillStyle = '#0d2a44'; rx.fillRect(BEACH * sc + ox, 0, W, W);
  rx.fillStyle = '#3a3220'; rx.fillRect(BEACH * sc + ox, 0, 150 * sc, W);
  rx.fillStyle = '#1d1a28';
  for (let i = 0; i < GRID; i++) for (let j = 0; j < GRID; j++) {
    rx.fillRect(((i - HALF) * STEP) * sc + ox - 22 * sc, ((j - HALF) * STEP) * sc + oz - 22 * sc, 44 * sc, 44 * sc);
  }
  rx.strokeStyle = '#4a4560'; rx.lineWidth = 18 * sc;
  for (const r of ROADS) {
    rx.beginPath(); rx.moveTo(r * sc + ox, -R); rx.lineTo(r * sc + ox, W + R); rx.stroke();
    rx.beginPath(); rx.moveTo(-R, r * sc + oz); rx.lineTo(W + R, r * sc + oz); rx.stroke();
  }
  if (mission.on) {
    const p = mission.pts[mission.idx];
    rx.fillStyle = '#ffd23f';
    rx.beginPath(); rx.arc(p.x * sc + ox, p.z * sc + oz, 6, 0, TAU); rx.fill();
  }
  rx.fillStyle = '#ff3b52';
  for (const c of cops) { rx.beginPath(); rx.arc(c.pos.x * sc + ox, c.pos.z * sc + oz, 5, 0, TAU); rx.fill(); }
  rx.save();
  rx.translate(f.x * sc + ox, f.z * sc + oz);
  rx.rotate(-(st.inCar ? st.inCar.yaw : player.yaw) + Math.PI);
  rx.fillStyle = '#5dfc9b';
  rx.beginPath(); rx.moveTo(0, -9); rx.lineTo(7, 7); rx.lineTo(0, 3); rx.lineTo(-7, 7); rx.closePath(); rx.fill();
  rx.restore();
  rx.restore();
}

function hud() {
  S('money').textContent = '$' + Math.round(st.money).toLocaleString('ru-RU');
  S('hp').style.width = clamp(st.hp, 0, 100) + '%';
  let s = '';
  for (let i = 0; i < 5; i++) s += `<span class="${i < st.wanted ? 'on' : ''}">★</span>`;
  S('stars').innerHTML = s;
}
let toastT = 0;
function toast(t) { S('toast').textContent = t; S('toast').classList.add('show'); toastT = 1.6; }

/* ---------- камера ---------- */
function updateCamera(dt) {
  const t = st.inCar ? st.inCar.pos : player.pos;
  const h = st.inCar ? 2.1 : 1.6;
  cam.dist = lerp(cam.dist, st.inCar ? (IS_TOUCH ? 13 : 12.5) : (IS_TOUCH ? 8 : 7.6), dt * 4);
  const focus = V3(t.x, t.y + h, t.z);
  const off = V3(Math.sin(cam.yaw) * Math.cos(cam.pitch), Math.sin(cam.pitch),
    Math.cos(cam.yaw) * Math.cos(cam.pitch)).multiplyScalar(cam.dist);
  const want = focus.clone().add(off);
  want.y = Math.max(want.y, .9);
  camera.position.lerp(want, clamp(dt * 10, 0, 1));
  camera.lookAt(focus.x, focus.y + (st.inCar ? .4 : .6), focus.z);
  sun.position.set(t.x + 90, 110, t.z - 60);
  sunTar.position.set(t.x, 0, t.z);
}

/* ---------- цикл ---------- */
const clock = new THREE.Clock();
let el = 0, frames = 0, fT = performance.now();

function loop() {
  requestAnimationFrame(loop);
  const dt = Math.min(clock.getDelta(), .05);
  el += dt;

  if (!IS_TOUCH) {
    let kx = 0, kz = 0;
    if (keys['KeyW'] || keys['ArrowUp']) kz += 1;
    if (keys['KeyS'] || keys['ArrowDown']) kz -= 1;
    if (keys['KeyA'] || keys['ArrowLeft']) kx -= 1;
    if (keys['KeyD'] || keys['ArrowRight']) kx += 1;
    if (kx || kz || !stickId) { input.x = kx; input.z = kz; }
  }

  if (st.inCar) driveCar(st.inCar, dt); else updatePlayer(dt);
  updateWorld(dt);
  updateCops(dt);
  updateBullets(dt);
  updateMission(dt);
  updateCamera(dt);

  if (st.wanted > 0) {
    st.cool -= dt;
    if (st.cool <= 0) { st.wanted--; syncCops(); st.cool = 13; }
  }
  if (st.hp < 100 && st.hp > 0) { st.hp = Math.min(100, st.hp + dt * 1.6); hud(); }

  for (const m of neon) {
    const k = .82 + Math.sin(el * 4 + m.userData.ph) * .18;
    m.material.color.setHex(m.userData.col).multiplyScalar(k * 1.35);
  }
  for (const m of mission.mk) m.userData.ring.rotation.z += dt * 1.6;
  oceanMat.uniforms.uT.value = el;

  if (toastT > 0) { toastT -= dt; if (toastT <= 0) S('toast').classList.remove('show'); }

  if (AU.ready) {
    const c = st.inCar, sp = c ? c.vel.length() : 0, now = AU.ctx.currentTime;
    AU.eng.g.gain.setTargetAtTime(c ? .035 + sp / 60 * .085 : 0, now, .12);
    const base = 52 + sp * 6.5;
    AU.eng.o1.frequency.setTargetAtTime(base, now, .09);
    AU.eng.o2.frequency.setTargetAtTime(base * 1.51, now, .09);
    AU.eng.f.frequency.setTargetAtTime(380 + sp * 22, now, .12);
    let near = false;
    for (const cop of cops) if (cop.pos.distanceTo(player.pos) < 90) { near = true; break; }
    AU.siren.gain.setTargetAtTime(near ? .026 : 0, now, .2);
    if (c && sp > 1.5) {
      rT -= dt;
      if (rT <= 0) {
        rT = .24;
        tone(NOTES[rStep++ % NOTES.length], .2, 'triangle', .04);
      }
    }
  }

  if (SHOW_FPS) {
    frames++;
    const n = performance.now();
    if (n - fT > 500) {
      S('fps').textContent = Math.round(frames * 1000 / (n - fT)) + ' FPS';
      frames = 0; fT = n;
    }
  }

  drawRadar();
  renderer.render(scene, camera);
}

/* ---------- старт ---------- */
addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

S('keysHint').innerHTML = IS_TOUCH
  ? ['Стик — ходить/рулить', '🚗 — сесть', '🔥 — стрелять', '⤒ — прыжок/ручник', 'Свайп — камера', 'МИССИЯ — заезд']
      .map(t => `<span>${t}</span>`).join('')
  : ['WASD — идти', 'Shift — бег', 'Space — прыжок/ручник', 'E — машина', 'ЛКМ — стрельба', 'M — миссия']
      .map(t => `<span>${t}</span>`).join('');

if (IS_TOUCH) S('touch').classList.add('on');
if (SHOW_FPS) S('fps').classList.add('show');

S('play').addEventListener('click', () => {
  if (started) return;
  started = true;
  audio();
  S('start').style.display = 'none';
  if (!IS_TOUCH) renderer.domElement.requestPointerLock?.();
  toast('ДОБРО ПОЖАЛОВАТЬ');
});

setInterval(() => {
  const h = S('hint');
  h.textContent = st.inCar
    ? (IS_TOUCH ? 'Стик — газ и руль · ⤒ — ручник' : 'W/S — газ · A/D — руль · Space — ручник · E — выйти')
    : (nearest(6.5)
      ? (IS_TOUCH ? '🚗 — сесть в машину' : 'E — сесть в машину · ЛКМ — стрельба')
      : (IS_TOUCH ? 'Стик — идти · свайп — камера' : 'WASD — идти · Shift — бег · M — миссия'));
}, 900);

hud(); syncCops(); loop();
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Neon Drift</title>
<style>
html,body{margin:0;height:100%;overflow:hidden;background:#0a0410;touch-action:none;
  font-family:system-ui,sans-serif;color:#fff;user-select:none}
canvas{display:block;width:100%;height:100%}
#ui{position:fixed;inset:0;pointer-events:none;padding:calc(12px + env(safe-area-inset-top)) 14px}
#hud{display:flex;justify-content:space-between;font:700 13px/1.5 system-ui}
#hud b{display:block;font-size:22px;color:#ff3d78}
#msg{position:absolute;left:50%;top:45%;transform:translate(-50%,-50%);text-align:center;
  font:800 26px/1.3 system-ui;letter-spacing:2px;opacity:0;transition:.3s}
#msg.on{opacity:1}
#fps{position:fixed;right:10px;bottom:calc(10px + env(safe-area-inset-bottom));font:700 11px ui-monospace,monospace;
  color:#8dffb0;background:rgba(0,0,0,.55);padding:5px 8px;border-radius:6px;display:none}
</style></head><body>
<canvas id="c"></canvas>
<div id="ui"><div id="hud">
  <div>ВРЕМЯ<b id="t">60.0</b></div>
  <div style="text-align:center">КРУГИ<b id="l">0</b></div>
  <div style="text-align:right">ДРИФТ<b id="d">0</b></div>
</div></div>
<div id="msg"></div><div id="fps">-- FPS</div>
<script>
const cvs=document.getElementById('c'),x=cvs.getContext('2d');
const S=id=>document.getElementById(id);
const FPS_ON=new URLSearchParams(location.search).has('fps');
if(FPS_ON)S('fps').style.display='block';
let W=0,H=0,DPR=1;
function resize(){DPR=Math.min(devicePixelRatio||1,2);W=innerWidth;H=innerHeight;
  cvs.width=W*DPR;cvs.height=H*DPR;x.setTransform(DPR,0,0,DPR,0,0);}
addEventListener('resize',resize);resize();

/* трасса — замкнутый овал из точек */
const TRACK=[];
for(let i=0;i<48;i++){const a=i/48*Math.PI*2;
  const rx=760,rz=520;
  TRACK.push({x:Math.cos(a)*rx+Math.sin(a*3)*70,z:Math.sin(a)*rz+Math.cos(a*2)*50});}
const CP=[];for(let i=0;i<8;i++)CP.push(TRACK[Math.floor(i/8*TRACK.length)]);

const car={x:0,z:0,a:0,vx:0,vz:0,ang:0};
let camX=0,camZ=0;
const keys={};
let touchX=0,touchAccel=1,drifting=0,timeLeft=60,laps=0,driftScore=0,nextCP=0,running=true;
const trail=[];

addEventListener('keydown',e=>{keys[e.code]=true;if(['Space','ArrowUp','ArrowDown'].includes(e.code))e.preventDefault()});
addEventListener('keyup',e=>keys[e.code]=false);
cvs.addEventListener('pointerdown',e=>{
  const r=cvs.getBoundingClientRect();
  if(e.clientX<r.width*0.4)touchX=-1;else if(e.clientX>r.width*0.6)touchX=1;else touchX=0;
  touchAccel=1;
});
cvs.addEventListener('pointermove',e=>{
  if(e.buttons||e.pointerType==='touch')return;
});
addEventListener('pointerup',()=>touchX=0);

function msg(t,ms=1200){S('msg').textContent=t;S('msg').classList.add('on');
  clearTimeout(msg._t);msg._t=setTimeout(()=>S('msg').classList.remove('on'),ms);}

let last=performance.now(),acc=0,frames=0;
function loop(now){
  requestAnimationFrame(loop);
  const dt=Math.min((now-last)/1000,.05);last=now;

  if(FPS_ON){frames++;acc+=dt;if(acc>.5){S('fps').textContent=Math.round(frames/acc)+' FPS';frames=0;acc=0;}}

  let steer=0,gas=0;
  if(keys['ArrowLeft']||keys['KeyA'])steer-=1;
  if(keys['ArrowRight']||keys['KeyD'])steer+=1;
  if(keys['ArrowUp']||keys['KeyW'])gas+=1;
  if(keys['ArrowDown']||keys['KeyS'])gas-=.6;
  steer+=touchX;gas+=1;
  steer=Math.max(-1,Math.min(1,steer));
  const hand=keys['Space'];

  const acc=gas*260;
  car.vx+=Math.sin(car.a)*acc*dt;
  car.vz+=Math.cos(car.a)*acc*dt;

  const sp=Math.hypot(car.vx,car.vz);
  if(hand)car.vx*=.985,car.vz*=.985;
  car.vx*=(1-1.1*dt);car.vz*=(1-1.1*dt);
  const maxSp=340;if(sp>maxSp){car.vx*=maxSp/sp;car.vz*=maxSp/sp;}

  const sf=Math.min(1,sp/90);
  car.a-=steer*3.2*dt*sf;

  /* сцепление */
  const fx=Math.sin(car.a),fz=Math.cos(car.a);
  const proj=car.vx*fx+car.vz*fz;
  const grip=hand?0.9:5.2;
  car.vx+=(fx*proj-car.vx)*Math.min(1,grip*dt);
  car.vz+=(fz*proj-car.vz)*Math.min(1,grip*dt);

  car.x+=car.vx*dt;car.z+=car.vz*dt;

  /* дрифт-скорость */
  const lateral=Math.abs(car.vx*fz-car.vz*fx);
  if(lateral>40&&sp>60)drifting+=1;else drifting=Math.max(0,drifting-2);
  driftScore+=lateral*dt*0.4;

  /* чекпоинты */
  const cp=CP[nextCP];
  if(Math.hypot(car.x-cp.x,car.z-cp.z)<120){
    nextCP=(nextCP+1)%CP.length;
    if(nextCP===0){laps++;msg('КРУГ '+laps);}
    timeLeft+=4;
    driftScore+=300;
  }
  timeLeft-=dt;
  if(timeLeft<=0&&running){running=false;msg('ФИНИШ · КРУГОВ '+laps+' · ОЧКИ '+Math.round(driftScore),3000);
    setTimeout(()=>{timeLeft=60;laps=0;driftScore=0;car.x=0;car.z=0;car.a=0;car.vx=0;car.vz=0;
      nextCP=0;running=true;},3200);}

  if(running===false)gas=0;

  /* камера */
  camX+=(car.x-camX)*Math.min(1,6*dt);
  camZ+=(car.z-camZ)*Math.min(1,6*dt);

  /* след шин */
  if(lateral>25){trail.push({x:car.x,z:car.z,life:1.6});if(trail.length>260)trail.shift();}
  for(let i=trail.length-1;i>=0;i--){trail[i].life-=dt;if(trail[i].life<=0)trail.splice(i,1);}

  /* отрисовка */
  x.fillStyle='#0a0410';x.fillRect(0,0,W,H);
  const zoom=Math.min(W,H)/520;
  x.save();
  x.translate(W/2,H/2);
  x.scale(zoom,zoom);
  x.translate(-camX,-camZ);

  /* трасса */
  x.strokeStyle='#1b0f2c';x.lineWidth=170;x.lineJoin='round';x.beginPath();
  TRACK.forEach((p,i)=>i?x.lineTo(p.x,p.z):x.moveTo(p.x,p.z));x.closePath();x.stroke();
  x.strokeStyle='#2a1442';x.lineWidth=140;x.stroke();
  x.strokeStyle='#ff2d6f';x.globalAlpha=.45;x.lineWidth=3;
  x.setLineDash([26,22]);x.stroke();x.setLineDash([]);x.globalAlpha=1;

  /* чекпоинты */
  CP.forEach((p,i)=>{
    const on=i===nextCP;
    x.fillStyle=on?'#ffd23f':'#3a2450';
    x.beginPath();x.arc(p.x,p.z,on?46:30,0,Math.PI*2);x.fill();
    if(on){x.strokeStyle='rgba(255,210,63,.4)';x.lineWidth=12;x.stroke();}
  });

  /* следы */
  trail.forEach(t=>{x.globalAlpha=t.life*.35;x.fillStyle='#ff2d6f';
    x.beginPath();x.arc(t.x,t.z,7,0,Math.PI*2);x.fill();});
  x.globalAlpha=1;

  /* машина */
  x.save();x.translate(car.x,car.z);x.rotate(-car.a+Math.PI/2);
  x.fillStyle='#ff2d6f';x.shadowColor='#ff2d6f';x.shadowBlur=26;
  x.beginPath();x.roundRect(-16,-26,32,52,7);x.fill();
  x.shadowBlur=0;x.fillStyle='#12060f';x.fillRect(-10,-6,20,16);
  x.fillStyle='#fff';x.fillRect(-12,-26,6,6);x.fillRect(6,-26,6,6);
  x.restore();

  x.restore();

  S('t').textContent=Math.max(0,timeLeft).toFixed(1);
  S('l').textContent=laps;
  S('d').textContent=Math.round(driftScore);
}
requestAnimationFrame(loop);
</script></body></html>
