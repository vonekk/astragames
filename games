  if (side === 0) return { x: cx - h + u, z: cz - h, dx: 1, dz: 0 };
  if (side === 1) return { x: cx + h, z: cz - h + u, dx: 0, dz: 1 };
  if (side === 2) return { x: cx + h - u, z: cz + h, dx: -1, dz: 0 };
  return { x: cx - h, z: cz + h - u, dx: 0, dz: -1 };
}
